<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimpleScanner.ViewModels"
        xmlns:rr="using:SimpleScanner.RadioReference"
        x:Class="SimpleScanner.Views.RadioReferenceWindow"
        x:DataType="vm:RadioReferenceViewModel"
        Icon="avares://SimpleScanner/Assets/icon.png"
        Title="SimpleScanner: RadioReference" Width="1120" Height="720" MinWidth="860" MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <!-- The account -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
      <Panel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !SignedIn}">
          <TextBlock Text="RadioReference account" Classes="label" />
          <TextBox Text="{Binding Username}" PlaceholderText="User name" Width="180" />
          <TextBox Text="{Binding Password}" PlaceholderText="Password" PasswordChar="•" Width="180">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding SignInCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
          <CheckBox IsChecked="{Binding Remember}" Content="Remember user name and password" MinHeight="0" FontSize="12"
                    ToolTip.Tip="{Binding RememberTip}" />
          <Button Classes="seg lit" Content="Sign in" Command="{Binding SignInCommand}"
                  ToolTip.Tip="Your own radioreference.com account. Their web service needs a Premium subscription." />
        </StackPanel>
        <DockPanel IsVisible="{Binding SignedIn}">
          <Button DockPanel.Dock="Right" Classes="seg" Content="Sign out" Command="{Binding SignOutCommand}"
                  ToolTip.Tip="Sign out and forget the password kept on this computer" />
          <TextBlock Text="{Binding AccountText}" VerticalAlignment="Center" />
        </DockPanel>
      </Panel>
    </Border>

    <!-- The place -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8" IsEnabled="{Binding SignedIn}">
      <TextBlock Text="ZIP code" Classes="label" />
      <TextBox Text="{Binding Zip}" Width="84" MaxLength="5"
               ToolTip.Tip="A United States ZIP code finds its county, and distances are then shown from it">
        <TextBox.KeyBindings>
          <KeyBinding Gesture="Enter" Command="{Binding FindZipCommand}" />
        </TextBox.KeyBindings>
      </TextBox>
      <Button Classes="seg" Content="Find" Command="{Binding FindZipCommand}" />
      <TextBlock Text="or" Classes="label" Margin="6,0" />
      <ComboBox ItemsSource="{Binding Countries}" SelectedItem="{Binding SelectedCountry}" Width="190" PlaceholderText="Country">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="rr:RrCountry"><TextBlock Text="{Binding Name}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState}" Width="190" PlaceholderText="State or province">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="rr:RrState"><TextBlock Text="{Binding Name}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <ComboBox ItemsSource="{Binding Counties}" SelectedItem="{Binding SelectedCounty}" Width="210" PlaceholderText="County">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="rr:RrCounty"><TextBlock Text="{Binding Name}" /></DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Button Classes="seg" Content="Fetch again" Command="{Binding RefreshCommand}"
              ToolTip.Tip="What is fetched is kept on this computer for a week. This asks RadioReference for the county afresh." />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource WarnText}" FontSize="12"
               TextWrapping="Wrap" Margin="2,8,0,0" MinHeight="16" />

    <!-- Loading what is ticked -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="10" Margin="0,8,0,0">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="seg" Classes.lit="{Binding CanLoad}" Content="Load" Command="{Binding LoadCommand}" IsEnabled="{Binding CanLoad}" Margin="6,0,0,0"
                ToolTip.Tip="Fetch the ticked lists and store their frequencies as channels, and the ticked P25 systems with their sites and talkgroups. Nothing already stored is added twice." />
        <TextBox DockPanel.Dock="Right" Text="{Binding LoadGroup}" Width="260" Margin="6,0,0,0"
                 ToolTip.Tip="The group the loaded channels go in. Each channel's tag (Fire Dispatch, Law Tac…) also makes a group by itself. Systems need no group.">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding LoadCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBlock DockPanel.Dock="Right" Text="into group" Classes="label" Margin="12,0,0,0" />
        <TextBlock Text="{Binding TickedText}" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="5*,12,7*">
      <!-- What the place has: tick the lists wanted -->
      <TreeView Grid.Column="0" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedNode}"
                Background="{DynamicResource PanelBg}" CornerRadius="8">
        <TreeView.Styles>
          <Style Selector="TreeViewItem" x:DataType="vm:RrNode">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="MinHeight" Value="24" />
          </Style>
        </TreeView.Styles>
        <TreeView.ItemTemplate>
          <TreeDataTemplate x:DataType="vm:RrNode" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <CheckBox IsChecked="{Binding IsChecked}" IsVisible="{Binding CanCheck}" MinWidth="0" MinHeight="0" Padding="0" />
              <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" Classes.label="{Binding Dim}" />
              <TextBlock Text="{Binding Detail}" Classes="label" />
            </StackPanel>
          </TreeDataTemplate>
        </TreeView.ItemTemplate>
      </TreeView>

      <!-- The frequencies of the list selected in the tree -->
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewTitle}" FontWeight="SemiBold" Margin="2,0,0,6" MinHeight="18" />
        <Grid DockPanel.Dock="Top" ColumnDefinitions="78,130,*,110,54,100" Margin="8,0,8,2" IsVisible="{Binding !PreviewIsSystem}">
          <TextBlock Grid.Column="0" Text="MHz" Classes="label" />
          <TextBlock Grid.Column="1" Text="Name" Classes="label" />
          <TextBlock Grid.Column="2" Text="Description" Classes="label" />
          <TextBlock Grid.Column="3" Text="Tag" Classes="label" />
          <TextBlock Grid.Column="4" Text="Type" Classes="label" />
          <TextBlock Grid.Column="5" Text="Tone / code" Classes="label" />
        </Grid>
        <Panel>
          <ListBox ItemsSource="{Binding Preview}" Background="{DynamicResource PanelBg}" CornerRadius="8">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="MinHeight" Value="0" />
              </Style>
              <Style Selector="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Margin" Value="0,0,8,0" />
              </Style>
            </ListBox.Styles>
            <ListBox.DataTemplates>
              <DataTemplate x:DataType="vm:RrFreqRow">
                <Grid ColumnDefinitions="78,130,*,110,54,100">
                  <TextBlock Grid.Column="0" Text="{Binding MHz}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" />
                  <TextBlock Grid.Column="2" Text="{Binding Description}" />
                  <TextBlock Grid.Column="3" Text="{Binding Tag}" />
                  <TextBlock Grid.Column="4" Text="{Binding Type}" />
                  <TextBlock Grid.Column="5" Text="{Binding Tone}" />
                </Grid>
              </DataTemplate>
              <!-- A system's site or talkgroup, in the same columns; a heading line names them -->
              <DataTemplate x:DataType="vm:RrTrunkRow">
                <Grid ColumnDefinitions="78,130,*,110,54,100">
                  <TextBlock Grid.Column="0" Text="{Binding Number}" Classes.label="{Binding Heading}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" Classes.label="{Binding Heading}" />
                  <TextBlock Grid.Column="2" Text="{Binding Description}" Classes.label="{Binding Heading}" ToolTip.Tip="{Binding Description}" />
                  <TextBlock Grid.Column="3" Text="{Binding Tag}" Classes.label="{Binding Heading}" />
                  <TextBlock Grid.Column="4" Text="{Binding Mode}" Classes.label="{Binding Heading}" />
                  <TextBlock Grid.Column="5" Text="{Binding Last}" Classes.label="{Binding Heading}" />
                </Grid>
              </DataTemplate>
            </ListBox.DataTemplates>
          </ListBox>
          <TextBlock Classes="label" TextWrapping="Wrap" MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                     IsVisible="{Binding !Preview.Count}"
                     Text="Click a list in the tree (a line with no arrow) to see its frequencies here, or a P25 system to see its sites and talkgroups. Tick what you want, then press Load." />
        </Panel>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
