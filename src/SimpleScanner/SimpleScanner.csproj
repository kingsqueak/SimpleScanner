<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.1.4</Version>
    <Product>SimpleScanner</Product>
    <ApplicationIcon>Assets/icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/icon.png" />
    <!-- The Help text, read by Help.Load -->
    <EmbeddedResource Include="Assets/help.md" LogicalName="SimpleScanner.help.md" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleScanner.Tests" />
    <InternalsVisibleTo Include="rsp-bench" />
  </ItemGroup>

  <!-- The audio output library (miniaudio behind a small C shim), built for this machine by
       native/audio/build.sh when it is missing, and copied next to the app. -->
  <PropertyGroup>
    <AudioLibName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libss_audio.dylib</AudioLibName>
    <AudioLibName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libss_audio.so</AudioLibName>
    <AudioLibName Condition="$([MSBuild]::IsOSPlatform('Windows'))">ss_audio.dll</AudioLibName>
    <AudioLibPath>$(MSBuildThisFileDirectory)../../native/audio/out/$(AudioLibName)</AudioLibPath>
  </PropertyGroup>
  <Target Name="BuildAudioLib" BeforeTargets="BeforeBuild" Condition="!Exists('$(AudioLibPath)') And !$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="sh &quot;$(MSBuildThisFileDirectory)../../native/audio/build.sh&quot;" />
  </Target>
  <!-- The digital voice library (P25 Phase 1, DMR, NXDN and D-STAR on RadioFoundry, native/digital), the same way. -->
  <PropertyGroup>
    <DigitalLibName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libss_digital.dylib</DigitalLibName>
    <DigitalLibName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libss_digital.so</DigitalLibName>
    <DigitalLibName Condition="$([MSBuild]::IsOSPlatform('Windows'))">ss_digital.dll</DigitalLibName>
    <DigitalLibPath>$(MSBuildThisFileDirectory)../../native/digital/out/$(DigitalLibName)</DigitalLibPath>
  </PropertyGroup>
  <Target Name="BuildDigitalLib" BeforeTargets="BeforeBuild" Condition="!Exists('$(DigitalLibPath)') And !$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="sh &quot;$(MSBuildThisFileDirectory)../../native/digital/build.sh&quot;" />
  </Target>
  <ItemGroup>
    <None Include="$(DigitalLibPath)" Link="$(DigitalLibName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(DigitalLibPath)') Or !$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
  <!-- The AMBE speech decoders for DMR, NXDN and D-STAR (mbelib, native/ambe). Optional: AMBE+2 is patented until
       2028, so a build can leave it out with -p:IncludeAmbe=false; those calls are then shown, not heard. -->
  <PropertyGroup>
    <IncludeAmbe Condition="'$(IncludeAmbe)' == ''">true</IncludeAmbe>
    <AmbeLibName Condition="$([MSBuild]::IsOSPlatform('OSX'))">libss_ambe.dylib</AmbeLibName>
    <AmbeLibName Condition="$([MSBuild]::IsOSPlatform('Linux'))">libss_ambe.so</AmbeLibName>
    <AmbeLibName Condition="$([MSBuild]::IsOSPlatform('Windows'))">ss_ambe.dll</AmbeLibName>
    <AmbeLibPath>$(MSBuildThisFileDirectory)../../native/ambe/out/$(AmbeLibName)</AmbeLibPath>
  </PropertyGroup>
  <Target Name="BuildAmbeLib" BeforeTargets="BeforeBuild" Condition="'$(IncludeAmbe)' == 'true' And !Exists('$(AmbeLibPath)') And !$([MSBuild]::IsOSPlatform('Windows'))">
    <Exec Command="sh &quot;$(MSBuildThisFileDirectory)../../native/ambe/build.sh&quot;" />
  </Target>
  <ItemGroup Condition="'$(IncludeAmbe)' == 'true'">
    <None Include="$(AmbeLibPath)" Link="$(AmbeLibName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(AmbeLibPath)') Or !$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(AudioLibPath)" Link="$(AudioLibName)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(AudioLibPath)') Or !$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

</Project>
