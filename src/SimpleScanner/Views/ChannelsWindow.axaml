<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimpleScanner.ViewModels"
        x:Class="SimpleScanner.Views.ChannelsWindow"
        x:DataType="vm:ChannelsViewModel"
        Icon="avares://SimpleScanner/Assets/icon.png"
        Title="SimpleScanner channels" Width="1400" Height="740" MinWidth="1180" MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <!-- Filter, and the import button -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <Button DockPanel.Dock="Right" Classes="seg" Content="Import RadioReference CSV…" Click="OnImportClick" Margin="6,0,0,0"
              ToolTip.Tip="Load one or more frequency downloads from radioreference.com (a county's or an agency's CSV file)" />
      <Button DockPanel.Dock="Right" Classes="seg" Content="RadioReference online…" Click="OnOnlineClick" Margin="6,0,0,0"
              ToolTip.Tip="Browse radioreference.com by place and load the categories you tick. Needs your own RadioReference account with a Premium subscription." />
      <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Classes="label" Margin="12,0,0,0" />
      <Button DockPanel.Dock="Right" Classes="seg" Content="Groups ▾" Margin="6,0,0,0"
              ToolTip.Tip="The groups editor: make a new group, and rename or delete one">
        <Button.Flyout>
          <Flyout Placement="BottomEdgeAlignedRight">
            <StackPanel Spacing="8" Width="340">
              <TextBlock Text="Groups" FontWeight="SemiBold" />
              <!-- The user's groups; picking one shows its channels in the list -->
              <ListBox ItemsSource="{Binding EditorGroups}" SelectedItem="{Binding EditorGroup}" MaxHeight="240"
                       ToolTip.Tip="Pick a group to show its channels in the list and to rename or delete it">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="8,3" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GroupEntry">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Classes="label" Margin="8,0,0,0" />
                      <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="seg" Content="New group" Command="{Binding MakeGroupCommand}" Margin="6,0,0,0"
                        ToolTip.Tip="Make a group with this name. It stays, empty, until channels are put in it: select them in the list and tick the group at the right." />
                <TextBox Text="{Binding GroupToMake}" PlaceholderText="Name of a new group">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding MakeGroupCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
              </DockPanel>
              <Border Height="1" Background="{DynamicResource TextMuted}" Opacity="0.35" />
              <StackPanel Spacing="8" IsEnabled="{Binding IsGroupChosen}">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Classes="seg" Content="Rename" Command="{Binding RenameGroupCommand}" Margin="6,0,0,0"
                          ToolTip.Tip="Give the group picked above this name. If another group already has the name, the two become one." />
                  <TextBox Text="{Binding GroupNewName}" PlaceholderText="Pick a group above to rename it">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding RenameGroupCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                </DockPanel>
                <Button Classes="seg" Content="Delete this group" Command="{Binding DeleteGroupCommand}" HorizontalAlignment="Left" />
              </StackPanel>
              <TextBlock Classes="label" TextWrapping="Wrap"
                         Text="Deleting a group leaves its channels stored, in any other groups they are in. To remove the channels too, select them in the list first and use Delete." />
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
      <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding GroupChoices}" SelectedItem="{Binding GroupFilter}" Width="230" Margin="8,0,0,0"
                ToolTip.Tip="Show only the channels of one group, or those in no group yet" />
      <TextBox Text="{Binding Filter}" PlaceholderText="Filter: any words from the name, agency, description, tag, tone, callsign or frequency"
               ToolTip.Tip="Type words to narrow the list, such as: fire dispatch, or 154." />
    </DockPanel>

    <!-- The duplicate checker -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="Duplicates" Classes="label" />
      <ComboBox ItemsSource="{x:Static vm:ChannelsViewModel.DuplicateChoices}" SelectedItem="{Binding DuplicateMode}" Width="270"
                ToolTip.Tip="List only the channels stored more than once, set by set, each with all its fields. Choose what counts as the same channel. The filter and the group chosen above still apply." />
      <Button Classes="seg" Content="Select the extras" Command="{Binding SelectExtrasCommand}" IsVisible="{Binding ShowingDuplicates}"
              ToolTip.Tip="Select every channel but the first (the fullest) of each set, ready for Delete. Nothing is deleted until you press Delete." />
      <TextBlock Text="{Binding DuplicateText}" VerticalAlignment="Center" FontSize="12" IsVisible="{Binding ShowingDuplicates}" />
      <TextBlock Classes="label" IsVisible="{Binding ShowingDuplicates}"
                 Text="Select a channel to change its fields at the right, so that two that share a frequency can be told apart; select several to delete them." />
    </StackPanel>

    <!-- A file that has been read and waits for its group name -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="10" Margin="0,0,0,8"
            IsVisible="{Binding Pending, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="seg" Content="Leave out" Command="{Binding CancelImportCommand}" Margin="6,0,0,0" />
        <Button DockPanel.Dock="Right" Classes="seg lit" Content="Import" Command="{Binding ConfirmImportCommand}" Margin="6,0,0,0" />
        <TextBox DockPanel.Dock="Right" Text="{Binding ImportGroup}" Width="260" Margin="6,0,0,0"
                 ToolTip.Tip="The group the file's channels go in: a county or town name is the usual choice. They can be put in more groups afterwards.">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ConfirmImportCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBlock DockPanel.Dock="Right" Text="into group" Classes="label" Margin="12,0,0,0" />
        <TextBlock Text="{Binding Pending.Summary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="{DynamicResource WarnText}" FontSize="12"
               TextWrapping="Wrap" Margin="2,8,0,0" MinHeight="16" />

    <!-- The selected channel's fields, and the groups of the selected channels -->
    <Border DockPanel.Dock="Right" Width="330" Margin="12,0,0,0" Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="12">
      <ScrollViewer>
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding SelectionText}" Classes="label" TextWrapping="Wrap"
                     IsVisible="{Binding SelectionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Grid ColumnDefinitions="92,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6"
                DataContext="{Binding Selected}" x:DataType="vm:ChannelRow"
                IsVisible="{Binding $parent[Window].((vm:ChannelsViewModel)DataContext).Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Grid.Row="0" Text="Name" Classes="label" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" ToolTip.Tip="The short name shown large on the display" />
            <TextBlock Grid.Row="1" Text="Frequency" Classes="label" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Frequency, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="In MHz" />
            <TextBlock Grid.Row="2" Text="Agency" Classes="label" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Agency}" ToolTip.Tip="Who the channel belongs to: a town, an agency, a kind of business" />
            <TextBlock Grid.Row="3" Text="Description" Classes="label" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap" />
            <TextBlock Grid.Row="4" Text="Tag" Classes="label" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Tag}" ToolTip.Tip="The kind of traffic, such as Fire Dispatch or Law Tac" />
            <TextBlock Grid.Row="5" Text="Signal type" Classes="label" />
            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Format}"
                     ToolTip.Tip="What is sent, as a note for the display: FMN, P25, DMR, NXDN. Digital voice is recognised by itself whatever is written here." />
            <TextBlock Grid.Row="6" Text="Tone / code" Classes="label" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Tone}"
                     ToolTip.Tip="CTCSS tone, DCS code, P25 NAC or DMR colour code, as a note for the display. The scanner does not yet use it to filter what it stops on." />
            <TextBlock Grid.Row="7" Text="Callsign" Classes="label" />
            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Callsign}" ToolTip.Tip="The FCC licence's callsign" />
            <TextBlock Grid.Row="8" Text="Input" Classes="label" />
            <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Input, UpdateSourceTrigger=LostFocus}"
                     ToolTip.Tip="The repeater's input frequency in MHz, if it has one; empty for none" />
            <TextBlock Grid.Row="9" Text="Station class" Classes="label" />
            <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding StationClass}"
                     ToolTip.Tip="FCC station class: RM repeater, BM base and mobiles, M mobiles, B base, F fixed" />
            <TextBlock Grid.Row="10" Text="Location" Classes="label" />
            <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding Location}"
                     ToolTip.Tip="Where it is used: a town, a county, or statewide. Every location in use is also a scan group on the main window, made by itself." />
            <TextBlock Grid.Row="11" Text="Receive as" Classes="label" />
            <ComboBox Grid.Row="11" Grid.Column="1" ItemsSource="{x:Static vm:ChannelRow.ReceiveChoices}" SelectedItem="{Binding Receive}"
                      HorizontalAlignment="Stretch"
                      ToolTip.Tip="The mode and channel filter used when this channel is tuned or scanned. Digital voice (P25, DMR, NXDN, D-STAR, C4FM) is received as NFM 12.5 kHz." />
          </Grid>

          <StackPanel Spacing="8" IsVisible="{Binding HasSelection}">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <Button Classes="seg" Content="Scan" Command="{Binding ScanSelectedCommand}" ToolTip.Tip="Tick the selected channels for scanning" />
              <Button Classes="seg" Content="Don't scan" Command="{Binding UnscanSelectedCommand}"
                      ToolTip.Tip="Untick the selected channels: they stay stored but the scan passes them by" />
              <Button Classes="seg" Content="Delete" Command="{Binding DeleteSelectedCommand}" Margin="12,0,0,0"
                      ToolTip.Tip="Remove the selected channels altogether" />
            </StackPanel>

            <TextBlock Text="Groups" FontWeight="SemiBold" Margin="0,6,0,0" />
            <TextBlock Classes="label" TextWrapping="Wrap"
                       Text="A channel can be in as many groups as you like. The main window scans the groups ticked there." />
            <ItemsControl ItemsSource="{Binding GroupTicks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GroupTick">
                  <CheckBox IsChecked="{Binding Member}" Content="{Binding Name}" MinHeight="0" Padding="6,3" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="seg" Content="Add to group" Command="{Binding AddToNewGroupCommand}" Margin="6,0,0,0"
                      ToolTip.Tip="Put the selected channels in the group named, making it if it is new" />
              <TextBox Text="{Binding NewGroup}" PlaceholderText="New group name">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding AddToNewGroupCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </DockPanel>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <!-- The channels -->
    <Grid x:Name="HeadGrid" DockPanel.Dock="Top" Margin="8,0,8,2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding Heads[0].Width}" />
        <ColumnDefinition Width="{Binding Heads[1].Width}" />
        <ColumnDefinition Width="{Binding Heads[2].Width}" />
        <ColumnDefinition Width="{Binding Heads[3].Width}" />
        <ColumnDefinition Width="{Binding Heads[4].Width}" MinWidth="80" />
        <ColumnDefinition Width="{Binding Heads[5].Width}" />
        <ColumnDefinition Width="{Binding Heads[6].Width}" />
        <ColumnDefinition Width="{Binding Heads[7].Width}" />
        <ColumnDefinition Width="{Binding Heads[8].Width}" />
      </Grid.ColumnDefinitions>
      <Grid.Styles>
        <!-- A column heading: plain text that can be clicked to sort -->
        <Style Selector="Button.head">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
          <Setter Property="BorderThickness" Value="0" />
          <Setter Property="Padding" Value="0,2" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="FontSize" Value="11" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="Command" Value="{Binding SortByCommand}" />
          <Setter Property="ToolTip.Tip" Value="Click to sort by this column; click again for the other way round" />
        </Style>
        <Style Selector="Button.head:pointerover /template/ ContentPresenter#PART_ContentPresenter">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="{DynamicResource TextMain}" />
        </Style>
        <!-- The handle at a column's edge: drag it to make the column wider or narrower -->
        <Style Selector="Thumb.grip">
          <Setter Property="Width" Value="9" />
          <Setter Property="Cursor" Value="SizeWestEast" />
          <Setter Property="Focusable" Value="False" />
          <Setter Property="ToolTip.Tip" Value="Drag to make the column wider or narrower; double-click for its normal width" />
          <Setter Property="Template">
            <ControlTemplate>
              <Border Background="Transparent">
                <Border x:Name="Line" Width="2" CornerRadius="1" Margin="0,2" HorizontalAlignment="Center"
                        Background="{DynamicResource TextMuted}" Opacity="0.45" />
              </Border>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="Thumb.grip:pointerover /template/ Border#Line">
          <Setter Property="Background" Value="{DynamicResource TextMain}" />
          <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Thumb.grip:pressed /template/ Border#Line">
          <Setter Property="Background" Value="{DynamicResource TextMain}" />
          <Setter Property="Opacity" Value="1" />
        </Style>
      </Grid.Styles>
      <Button Grid.Column="0" Classes="head" Content="{Binding Heads[0].Text}" CommandParameter="Scan" />
      <Button Grid.Column="1" Classes="head" Content="{Binding Heads[1].Text}" CommandParameter="MHz" />
      <Button Grid.Column="2" Classes="head" Content="{Binding Heads[2].Text}" CommandParameter="Name" />
      <Button Grid.Column="3" Classes="head" Content="{Binding Heads[3].Text}" CommandParameter="Agency" />
      <Button Grid.Column="4" Classes="head" Content="{Binding Heads[4].Text}" CommandParameter="Description" />
      <Button Grid.Column="5" Classes="head" Content="{Binding Heads[5].Text}" CommandParameter="Tag" />
      <Button Grid.Column="6" Classes="head" Content="{Binding Heads[6].Text}" CommandParameter="Type" />
      <Button Grid.Column="7" Classes="head" Content="{Binding Heads[7].Text}" CommandParameter="Tone" />
      <Button Grid.Column="8" Classes="head" Content="{Binding Heads[8].Text}" CommandParameter="Groups" />
      <Thumb Grid.Column="0" Classes="grip" DataContext="{Binding Heads[0]}" HorizontalAlignment="Right" DragDelta="OnHeadDrag" DoubleTapped="OnHeadReset" />
      <Thumb Grid.Column="1" Classes="grip" DataContext="{Binding Heads[1]}" HorizontalAlignment="Right" DragDelta="OnHeadDrag" DoubleTapped="OnHeadReset" />
      <Thumb Grid.Column="2" Classes="grip" DataContext="{Binding Heads[2]}" HorizontalAlignment="Right" DragDelta="OnHeadDrag" DoubleTapped="OnHeadReset" />
      <Thumb Grid.Column="3" Classes="grip" DataContext="{Binding Heads[3]}" HorizontalAlignment="Right" DragDelta="OnHeadDrag" DoubleTapped="OnHeadReset" />
      <Thumb Grid.Column="5" Classes="grip" DataContext="{Binding Heads[5]}" HorizontalAlignment="Left" Margin="-9,0,0,0" DragDelta="OnHeadDrag" DoubleTapped="OnHeadReset" />
      <Thumb Grid.Column="6" Classes="grip" DataContext="{Binding Heads[6]}" HorizontalAlignment="Left" Margin="-9,0,0,0" DragDelta="OnHeadDrag" DoubleTapped="OnHeadReset" />
      <Thumb Grid.Column="7" Classes="grip" DataContext="{Binding Heads[7]}" HorizontalAlignment="Left" Margin="-9,0,0,0" DragDelta="OnHeadDrag" DoubleTapped="OnHeadReset" />
      <Thumb Grid.Column="8" Classes="grip" DataContext="{Binding Heads[8]}" HorizontalAlignment="Left" Margin="-9,0,0,0" DragDelta="OnHeadDrag" DoubleTapped="OnHeadReset" />
    </Grid>
    <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectionMode="Multiple" Background="{DynamicResource PanelBg}" CornerRadius="8"
             SelectionChanged="OnSelectionChanged" DoubleTapped="OnRowDoubleTapped"
             ToolTip.Tip="Double-click a channel to tune the radio to it">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Padding" Value="8,1" />
          <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="Grid.shaded">
          <Setter Property="Background" Value="{DynamicResource ControlBg}" />
        </Style>
        <Style Selector="TextBlock">
          <Setter Property="FontSize" Value="12" />
          <Setter Property="VerticalAlignment" Value="Center" />
          <Setter Property="TextTrimming" Value="CharacterEllipsis" />
          <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:ChannelRow">
          <Grid RowDefinitions="Auto,Auto" Classes.shaded="{Binding Shaded}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding Heads[0].Width}" />
              <ColumnDefinition Width="{Binding Heads[1].Width}" />
              <ColumnDefinition Width="{Binding Heads[2].Width}" />
              <ColumnDefinition Width="{Binding Heads[3].Width}" />
              <ColumnDefinition Width="{Binding Heads[4].Width}" MinWidth="80" />
              <ColumnDefinition Width="{Binding Heads[5].Width}" />
              <ColumnDefinition Width="{Binding Heads[6].Width}" />
              <ColumnDefinition Width="{Binding Heads[7].Width}" />
              <ColumnDefinition Width="{Binding Heads[8].Width}" />
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" IsChecked="{Binding Scan}" MinWidth="0" MinHeight="0" ToolTip.Tip="Include this channel when scanning" />
            <TextBlock Grid.Column="1" Text="{Binding Frequency}" />
            <TextBlock Grid.Column="2" Text="{Binding Name}" />
            <TextBlock Grid.Column="3" Text="{Binding Agency}" />
            <TextBlock Grid.Column="4" Text="{Binding Description}" />
            <TextBlock Grid.Column="5" Text="{Binding Tag}" />
            <TextBlock Grid.Column="6" Text="{Binding Format}" />
            <TextBlock Grid.Column="7" Text="{Binding Tone}" />
            <TextBlock Grid.Column="8" Text="{Binding Groups}" Foreground="{DynamicResource TextMuted}" />
            <!-- In the duplicate checker: a line over the first channel of each set, and the fields that have no column -->
            <Border Grid.ColumnSpan="9" Height="2" VerticalAlignment="Top" Margin="-8,-1,-8,0" IsVisible="{Binding FirstOfSet}"
                    Background="{DynamicResource Accent}" Opacity="0.7" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="8" Text="{Binding More}" IsVisible="{Binding InSet}"
                       Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,8,3" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
