<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SimpleScanner.ViewModels"
        xmlns:c="using:SimpleScanner.Controls"
        xmlns:v="using:SimpleScanner.Views"
        xmlns:r="using:SimpleScanner.Radio"
        x:Class="SimpleScanner.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="avares://SimpleScanner/Assets/icon.png"
        Title="SimpleScanner" Width="1130" Height="664" MinWidth="700" MinHeight="634"
        WindowStartupLocation="CenterScreen">
  <Panel Margin="12">

  <!-- The small window: the display, scaled to the window, and one row of buttons under it -->
  <DockPanel x:Name="MiniView" IsVisible="{Binding IsMini}">
    <WrapPanel DockPanel.Dock="Bottom" ItemSpacing="8" LineSpacing="6" Margin="0,8,0,0">
      <Button Classes="seg" Classes.lit="{Binding Radio.IsMuted}" Content="Mute" Command="{Binding Radio.ToggleMuteCommand}"
              ToolTip.Tip="Silence the speaker without touching the volume. Press again for sound." />
      <Button Classes="seg" Classes.lit="{Binding IsScanning}" Content="{Binding ScanText}"
              Command="{Binding ToggleScanCommand}" MinWidth="82"
              ToolTip.Tip="Scan the ticked channels of the groups shown" />
      <Button Classes="seg" Content="Skip" Command="{Binding Radio.SkipChannelCommand}"
              IsEnabled="{Binding Radio.IsScanning}" ToolTip.Tip="Leave the channel the scan has stopped on and carry on" />
      <Button Classes="seg" Content="Avoid" Command="{Binding Radio.AvoidChannelCommand}"
              IsEnabled="{Binding Radio.IsScanning}"
              ToolTip.Tip="Leave the channel the scan has stopped on and keep it out of the scan for the Avoid Timer set in Settings" />
      <!-- With one radio this button is on the display -->
      <Button Classes="seg" Content="Full window" Command="{Binding ToggleMiniCommand}" IsVisible="{Binding IsMulti}"
              ToolTip.Tip="Back to the full window" />
    </WrapPanel>
    <Panel>
      <Border Background="{DynamicResource LcdBg}" BorderBrush="{DynamicResource LcdBorder}" IsVisible="{Binding IsSingle}"
              BorderThickness="1" CornerRadius="8" Padding="10,6,10,8">
        <Viewbox Stretch="Uniform">
          <v:Display Width="600" DataContext="{Binding Radio}" />
        </Viewbox>
      </Border>
      <!-- Several radios: a strip each, scaled together to the window. The buttons below work the one selected. -->
      <Viewbox Stretch="Uniform" IsVisible="{Binding IsMulti}">
        <ItemsControl ItemsSource="{Binding RadioList}" Width="640">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="6" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RadioViewModel">
              <v:RadioStrip />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Viewbox>
    </Panel>
  </DockPanel>

  <DockPanel x:Name="FullView" IsVisible="{Binding !IsMini}">

    <!-- The readout: what a scanner shows on its display -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource LcdBg}" BorderBrush="{DynamicResource LcdBorder}"
            BorderThickness="1" CornerRadius="8" Padding="18,12,18,14" IsVisible="{Binding IsSingle}">
      <v:Display DataContext="{Binding Radio}" />
    </Border>
    <!-- Several radios: a strip each, one under another. The one clicked is the one the controls below work. -->
    <ScrollViewer DockPanel.Dock="Top" IsVisible="{Binding IsMulti}" MaxHeight="356"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding RadioList}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RadioViewModel">
            <v:RadioStrip />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Radio.Status}" Foreground="{DynamicResource WarnText}" FontSize="12"
               TextWrapping="Wrap" Margin="2,8,0,0" MinHeight="16" />

    <!-- The controls, in tabs under the readout -->
    <Panel Margin="0,8,0,0">
    <!-- With several radios the small-window button has no display to sit on: it is at the end of the tab headings -->
    <Button Classes="seg" Command="{Binding ToggleMiniCommand}" IsVisible="{Binding IsMulti}" ZIndex="1"
            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Padding="7,4" MinWidth="0"
            ToolTip.Tip="Small window: only the radios' displays, with Mute, Scan, Skip and Avoid under them">
      <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
            Stroke="{DynamicResource TextMuted}"
            Data="M 20,4 L 14,10 M 14,5 L 14,10 L 19,10 M 4,20 L 10,14 M 5,14 L 10,14 L 10,19" />
    </Button>
    <TabControl x:Name="Tabs" Padding="0" SelectionChanged="OnTabChanged">

      <TabItem Header="Operate">
        <DockPanel>
          <!-- The user groups again, at the right: the same rows as on Scan Groups, so a tick here is a tick there -->
          <Border DockPanel.Dock="Right" Width="230" Margin="12,10,0,0" Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="10">
            <!-- The groups take what they need, up to half the column (set in the code behind); the frequencies have the rest -->
            <Grid x:Name="GroupsColumn" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*" SizeChanged="OnGroupsColumnSized">
              <TextBlock Text="{Binding GroupsTitle}" Classes="label" FontWeight="SemiBold" Margin="2,0,0,2"
                         ToolTip.Tip="The groups you made. Tick one or several to show and scan; with none ticked on Scan Groups, all are. With several radios each has its own ticks: these are those of the radio selected, and a group ticked for more than one radio is shared out between them." />
              <Border Grid.Row="1" Height="1" Background="{DynamicResource TextMuted}" Opacity="0.35" Margin="0,0,0,4" />
              <ScrollViewer x:Name="GroupsScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding UserGroupRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupRow">
                      <CheckBox IsChecked="{Binding Selected}" Content="{Binding Label}" MinHeight="0" Padding="6,3" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <!-- What the radio selected scans: the ticked channels of its groups, or its share while it scans -->
              <TextBlock Grid.Row="3" Text="{Binding ActiveTitle}" Classes="label" FontWeight="SemiBold" Margin="2,10,0,2"
                         ToolTip.Tip="The frequencies of this radio's groups (every group ticked on Scan Groups counts, not only the user groups). Untick one to leave it out of the scan: it is the channel's Scan tick, the same one as on Scan Groups, so it is left out for every radio. A change takes effect at once. While this radio scans alongside another that has some of the same channels, the ticked ones that went to the other are not listed." />
              <Border Grid.Row="4" Height="1" Background="{DynamicResource TextMuted}" Opacity="0.35" Margin="0,0,0,4" />
              <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <!-- Only the lines in view are made: with no group ticked this is every stored channel -->
                <ItemsControl ItemsSource="{Binding ActiveFrequencies}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActiveFrequency">
                      <CheckBox IsChecked="{Binding Scan}" MinHeight="0" Height="26" Padding="6,0,0,0" Margin="0,0,10,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="62,*" ColumnSpacing="8">
                          <TextBlock Text="{Binding Frequency}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="label" TextTrimming="CharacterEllipsis" />
                        </Grid>
                      </CheckBox>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="44,*" Margin="2,8,0,0" ColumnSpacing="12">
          <!-- Scan the stored channels: kept at the foot of the tab -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Scan" Classes="label" VerticalAlignment="Top" Margin="0,8,0,0" />
          <WrapPanel Grid.Row="0" Grid.Column="1" ItemSpacing="8" LineSpacing="6">
            <Button Classes="seg" Classes.lit="{Binding IsScanning}" Content="{Binding ScanText}"
                    Command="{Binding ToggleScanCommand}" MinWidth="82"
                    ToolTip.Tip="Scan the ticked channels of the groups shown. It stops on a channel while there is a signal above the squelch mark, and for two seconds after." />
            <Button Classes="seg" Content="Skip" Command="{Binding Radio.SkipChannelCommand}"
                    IsEnabled="{Binding Radio.IsScanning}" ToolTip.Tip="Leave the channel the scan has stopped on and carry on" />
            <Button Classes="seg" Content="Avoid" Command="{Binding Radio.AvoidChannelCommand}"
                    IsEnabled="{Binding Radio.IsScanning}"
                    ToolTip.Tip="Leave the channel the scan has stopped on and keep it out of the scan for the Avoid Timer set in Settings. Closing the app clears every avoid." />
          </WrapPanel>
          </Grid>

          <!-- The rows wrap when the window is narrow (a label stays with its control); if they then need more height than there is, they scroll -->
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="44,*" Margin="2,12,0,4" RowSpacing="12" ColumnSpacing="12">

              <!-- Tuning: the frequency, and under it the step buttons (the power button is on the display) -->
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Tune" Classes="label" VerticalAlignment="Top" Margin="0,8,0,0" />
              <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6">
                <WrapPanel ItemSpacing="8" LineSpacing="6">
                  <TextBox Text="{Binding Radio.EntryText}" Width="120" PlaceholderText="MHz"
                           ToolTip.Tip="Type a frequency in MHz and press Enter">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding Radio.EnterFrequencyCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button Classes="seg" Content="Go" Command="{Binding Radio.EnterFrequencyCommand}" />
                </WrapPanel>
                <WrapPanel ItemSpacing="8" LineSpacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="seg" Content="◀" Command="{Binding Radio.StepDownCommand}" ToolTip.Tip="One step down" />
                    <Button Classes="seg" Content="▶" Command="{Binding Radio.StepUpCommand}" ToolTip.Tip="One step up" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Step" Classes="label" Margin="6,0,0,0" />
                    <ComboBox ItemsSource="{Binding Radio.Steps}" SelectedItem="{Binding Radio.SelectedStep}" Width="116"
                              ToolTip.Tip="Tuning step for the arrow buttons. Auto uses the usual channel spacing of the band." />
                  </StackPanel>
                </WrapPanel>
              </StackPanel>

              <!-- Mode, with the Stereo button at the end of the row -->
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Mode" Classes="label" VerticalAlignment="Top" Margin="0,8,0,0" />
                <WrapPanel Grid.Row="1" Grid.Column="1" ItemSpacing="8" LineSpacing="6">
                  <Button Classes="seg" Classes.lit="{Binding Radio.AutoMode}" Content="Auto" Command="{Binding Radio.SetAutoModeCommand}"
                          ToolTip.Tip="Choose the mode and filter from the band: AM on airband, FM elsewhere" />
                  <Button Classes="seg" Classes.lit="{Binding Radio.IsAm}" Content="AM" Command="{Binding Radio.SetModeCommand}" CommandParameter="AM" />
                  <Button Classes="seg" Classes.lit="{Binding Radio.IsNfm}" Content="NFM" Command="{Binding Radio.SetModeCommand}" CommandParameter="NFM"
                          ToolTip.Tip="Narrow FM: public service, business, marine, weather and amateur" />
                  <Button Classes="seg" Classes.lit="{Binding Radio.IsWfm}" Content="WFM" Command="{Binding Radio.SetModeCommand}" CommandParameter="WFM"
                          ToolTip.Tip="Wide FM: broadcast radio" />
                  <Button Classes="seg" Classes.lit="{Binding Radio.StereoOn}" Content="Stereo" Command="{Binding Radio.ToggleStereoCommand}"
                          ToolTip.Tip="Broadcast FM in stereo when the station sends it. Off is mono, which is quieter on a weak station." />
                </WrapPanel>
              <!-- The filter has a row of its own, close under the mode buttons -->
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Filter" Classes="label" Margin="0,-6,0,0" />
              <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Radio.Widths}" SelectedItem="{Binding Radio.SelectedWidth}" Width="170"
                        Margin="0,-6,0,0"
                        ToolTip.Tip="Channel filter. Use the narrow one where channels are 12.5 kHz (FM) or 8.33 kHz (AM) apart." />

              <!-- Audio: volume and mute, and under them the squelch -->
              <TextBlock Grid.Row="3" Grid.Column="0" Text="Audio" Classes="label" VerticalAlignment="Top" Margin="0,8,0,0" />
              <StackPanel Grid.Row="3" Grid.Column="1" Spacing="6">
                <WrapPanel ItemSpacing="8" LineSpacing="6">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Volume" Classes="label" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding Radio.Volume}" Width="170" />
                    <Button Classes="seg" Classes.lit="{Binding Radio.IsMuted}" Content="Mute" Command="{Binding Radio.ToggleMuteCommand}"
                            ToolTip.Tip="Silence the speaker without touching the volume. Press again for sound." />
                  </StackPanel>
                </WrapPanel>
                <!-- Pulled up: a slider keeps room above and below itself for tick marks it does not have -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,-22,0,0">
                  <TextBlock Text="Squelch" Classes="label" Classes.off="{Binding !Radio.SquelchOn}" />
                  <Slider Minimum="-140" Maximum="-40" Value="{Binding Radio.SquelchDb}" Width="162"
                          ToolTip.Tip="Squelch level: set the green mark just above the bar's resting level. All the way left is squelch off." />
                  <Button Classes="seg" Classes.lit="{Binding Radio.AutoSquelch}" Content="Auto" Command="{Binding Radio.ToggleAutoSquelchCommand}"
                          ToolTip.Tip="Auto squelch: also stay shut on noise, however strong. A channel must be above the squelch mark and carry a clean signal, so a noisy band does not open at a level set for quiet ones. FM (digital too) and AM." />
                </StackPanel>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <!-- Which groups of stored channels are shown on Operate and scanned -->
      <TabItem Header="Scan Groups">
        <DockPanel Margin="2,10,0,0">
          <!-- The stored channels of the groups ticked, at the right of the tab: tick to scan, select to tune, store and delete -->
          <Border DockPanel.Dock="Right" Width="290" Margin="12,0,0,0" Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="10">
            <DockPanel>
              <DockPanel DockPanel.Dock="Top" Margin="2,0,0,8"
                         ToolTip.Tip="The groups of stored channels shown here and scanned: those ticked at the left">
                <TextBlock DockPanel.Dock="Left" Text="Groups" Classes="label" Margin="0,0,8,0" />
                <TextBlock Text="{Binding GroupsText}" FontSize="13" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Classes="seg" Content="Delete" Command="{Binding DeleteChannelCommand}" Margin="6,0,0,0"
                        ToolTip.Tip="Remove the selected channel" />
                <Button DockPanel.Dock="Right" Classes="seg" Content="Store" Command="{Binding StoreChannelCommand}" Margin="6,0,0,0"
                        ToolTip.Tip="Store the frequency on the display under this name. With one group shown it goes in that group; otherwise in &quot;My channels&quot;, or where it already was" />
                <TextBox Text="{Binding NewName}" PlaceholderText="Name for this frequency" />
              </DockPanel>
              <ListBox ItemsSource="{Binding Memories}" SelectedItem="{Binding SelectedMemory}" Background="Transparent">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="8,2" />
                    <Setter Property="MinHeight" Value="0" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:MemoryRow">
                    <DockPanel>
                      <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Scan}" MinWidth="0" Margin="0,0,6,0"
                                ToolTip.Tip="Include this channel when scanning" />
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Classes="label" />
                      </StackPanel>
                    </DockPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Left" Classes="seg" Content="All groups" Command="{Binding ShowAllGroupsCommand}"
                    ToolTip.Tip="Untick every group: all of them are shown and scanned" />
            <TextBlock Text="Tick one or several groups to show and scan; with none ticked, all are."
                       Classes="label" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
          </DockPanel>
          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
            <Border Grid.Column="0" Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="10">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="User Groups" Classes="label" FontWeight="SemiBold" Margin="2,0,0,2"
                           ToolTip.Tip="The groups you made, in the channel editor or by importing" />
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource TextMuted}" Opacity="0.35" Margin="0,0,0,4" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding UserGroupRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GroupRow">
                        <CheckBox IsChecked="{Binding Selected}" Content="{Binding Label}" MinHeight="0" Padding="6,3" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="10">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Auto Groups · Location" Classes="label" FontWeight="SemiBold" Margin="2,0,0,2"
                           ToolTip.Tip="One group for each location in use, made by the program: a town, a county, or statewide and nationwide users. Channels loaded from RadioReference online have a location; it can be typed for any channel in the channel editor" />
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource TextMuted}" Opacity="0.35" Margin="0,0,0,4" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding PlaceGroupRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GroupRow">
                        <CheckBox IsChecked="{Binding Selected}" Content="{Binding Label}" MinHeight="0" Padding="6,3" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource PanelBg}" CornerRadius="8" Padding="10">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Auto Groups · Tag" Classes="label" FontWeight="SemiBold" Margin="2,0,0,2"
                           ToolTip.Tip="One group for each tag in use, made by the program: its channels are those with that tag, however the tag is written" />
                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource TextMuted}" Opacity="0.35" Margin="0,0,0,4" />
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding AutoGroupRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:GroupRow">
                        <CheckBox IsChecked="{Binding Selected}" Content="{Binding Label}" MinHeight="0" Padding="6,3" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </DockPanel>
            </Border>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- Not a page: choosing it opens the channel editor and the tab that was showing stays -->
      <TabItem x:Name="MemoryTab" Header="Memory Mgr"
               ToolTip.Tip="Open the channel editor: edit what is stored about each channel, put channels in groups, and load RadioReference CSV downloads" />

      <TabItem Header="Search">
        <Grid RowDefinitions="Auto" ColumnDefinitions="44,*" Margin="2,12,0,0" RowSpacing="12" ColumnSpacing="12">
          <!-- Search a range -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Search" Classes="label" VerticalAlignment="Top" Margin="0,8,0,0" />
          <WrapPanel Grid.Row="0" Grid.Column="1" ItemSpacing="8" LineSpacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBox Text="{Binding SearchFrom}" Width="90" ToolTip.Tip="Lowest frequency to search, in MHz" />
              <TextBlock Text="to" Classes="label" />
              <TextBox Text="{Binding SearchTo}" Width="90" ToolTip.Tip="Highest frequency to search, in MHz" />
              <TextBlock Text="MHz" Classes="label" />
            </StackPanel>
            <Button Classes="seg" Classes.lit="{Binding Radio.IsSearching}" Content="{Binding Radio.SearchText}" Command="{Binding ToggleSearchCommand}"
                    MinWidth="96" Margin="6,0,0,0"
                    ToolTip.Tip="Look through this range for anything above the squelch mark and stop on it. Uses the band's usual channel spacing unless a step is chosen. Skip leaves a frequency out for ten minutes; Store keeps it." />
            <Button Classes="seg" Content="Skip" Command="{Binding Radio.SkipChannelCommand}" IsEnabled="{Binding Radio.IsScanning}"
                    ToolTip.Tip="Leave the frequency the search has stopped on and carry on" />
          </WrapPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Settings">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="44,*" Margin="2,12,0,0" RowSpacing="12" ColumnSpacing="12">
          <!-- Sound device and radio -->
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Output" Classes="label" VerticalAlignment="Top" Margin="0,8,0,0" />
          <WrapPanel Grid.Row="0" Grid.Column="1" ItemSpacing="8" LineSpacing="6">
            <ComboBox ItemsSource="{Binding AudioDevices}" SelectedItem="{Binding SelectedAudioDevice}" Width="330"
                      ToolTip.Tip="Which sound device the scanner's audio goes to. It can be changed while receiving." />
            <Button Classes="seg" Content="Refresh" Command="{Binding RescanAudioDevicesCommand}"
                    ToolTip.Tip="Look again for sound devices, after plugging one in" />
          </WrapPanel>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Radio" Classes="label" VerticalAlignment="Top" Margin="0,8,0,0" />
          <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6">
          <WrapPanel ItemSpacing="8" LineSpacing="6" IsVisible="{Binding ShownIsHere}">
            <CheckBox Content="Auto gain" IsChecked="{Binding Radio.AutoGain}" FontSize="12"
                      ToolTip.Tip="Let the scanner step the radio's front-end attenuation: up on overload, back down when it clears" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="LNA step" Classes="label" Margin="6,0,0,0" />
              <Slider Minimum="0" Maximum="{Binding Radio.MaxGainStep}" Value="{Binding Radio.GainStep}" Width="170"
                      TickFrequency="1" IsSnapToTickEnabled="True"
                      ToolTip.Tip="Front-end attenuation: 0 is the most gain. With Auto gain on, this is the most gain the scanner may use." />
            </StackPanel>
          </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Receiver" Classes="label" Width="84" />
              <ComboBox ItemsSource="{Binding ReceiverChoices}" SelectedItem="{Binding ShownReceiver}" Width="190" PlaceholderText="None found"
                        ToolTip.Tip="The radio these settings belong to, when more than one is plugged in. Choosing one that is running selects it, as clicking its display does. A radio that another program is using is not listed.">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="r:RadioInfo">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <!-- On the receiver's line: the tab has no room for another line at the window's least height -->
              <TextBlock Text="Antenna" Classes="label" Margin="12,0,0,0" IsVisible="{Binding ShownIsHere}" />
              <ComboBox ItemsSource="{Binding Radio.Antennas}" SelectedItem="{Binding Radio.SelectedAntenna}" Width="130" IsVisible="{Binding ShownIsHere}" />
              <CheckBox Content="Use" IsChecked="{Binding ShownUse}" IsEnabled="{Binding CanSetUse}" FontSize="12" Margin="12,0,0,0"
                        ToolTip.Tip="Run this radio whenever it is plugged in. With several ticked, all run at once, each with a display of its own and a share of the scan. A change takes effect when the app is next started. With none ticked, the radio used last is used." />
            </StackPanel>
            <!-- A radio that is plugged in but not run by the program now -->
            <StackPanel Spacing="8" IsVisible="{Binding ShownIsElsewhere}">
              <TextBlock Classes="label" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"
                         Text="This radio is plugged in but not running here. With Use ticked it runs beside the others from the next start of the app; its own settings are shown once it is running." />
              <Button Classes="seg" Content="Change over to this radio now" Command="{Binding ChangeOverCommand}" IsVisible="{Binding CanChangeOver}"
                      HorizontalAlignment="Left"
                      ToolTip.Tip="Stop using the radio in use and use this one in its place, at once. The settings on screen go with it." />
            </StackPanel>
            <CheckBox Content="FM broadcast notch" IsChecked="{Binding Radio.FmNotch}" IsEnabled="{Binding Radio.HasBiasT}" FontSize="12" IsVisible="{Binding ShownIsHere}"
                      ToolTip.Tip="Switch in the radio's filter that cuts the FM broadcast band (88 to 108 MHz), so strong stations there cannot overload it while it listens elsewhere. Turn it off to listen to broadcast FM." />
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShownIsHere}">
              <TextBlock Text="Correction" Classes="label" Width="84" />
              <NumericUpDown Value="{Binding Radio.Ppm}" Minimum="-100" Maximum="100" Increment="0.1" FormatString="0.0" Width="130"
                             ToolTip.Tip="Frequency correction for the radio's reference oscillator, in parts per million. 0 unless signals on known frequencies all read off by the same proportion." />
              <TextBlock Text="ppm" Classes="label" />
              <TextBlock Text="Pan" Classes="label" Margin="24,0,0,0" />
              <TextBlock Text="L" Classes="label" />
              <Slider Minimum="-1" Maximum="1" Value="{Binding Radio.Pan}" Width="130" Margin="0,-12" SmallChange="0.1" LargeChange="0.5"
                      ToolTip.Tip="Where this radio's sound sits between the left and the right speaker. With several radios, put each to a side to tell them apart by ear. The middle holds: a touch either side of it is the middle." />
              <TextBlock Text="R" Classes="label" />
            </StackPanel>
            <CheckBox Content="Enable bias T" IsChecked="{Binding Radio.BiasT}" IsEnabled="{Binding Radio.HasBiasT}" FontSize="12" IsVisible="{Binding ShownIsHere}"
                      ToolTip.Tip="Put DC (about 4.7 V) on the antenna socket to power a masthead preamplifier or an active antenna. On an RSPdx it is on Antenna B only. Leave it off unless something on that socket needs the power." />
          </StackPanel>
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Scan" Classes="label" VerticalAlignment="Top" Margin="0,8,0,0" />
          <StackPanel Grid.Row="2" Grid.Column="1" Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Avoid Timer" Classes="label" Width="84" />
              <ComboBox ItemsSource="{Binding AvoidTimes}" SelectedItem="{Binding SelectedAvoidTime}" Width="130"
                        ToolTip.Tip="How long the Avoid button keeps a frequency out of the scan. Full session is until the app is closed. A change applies to frequencies avoided from then on." />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Resume Timer" Classes="label" Width="84" />
              <ComboBox ItemsSource="{Binding ResumeTimes}" SelectedItem="{Binding SelectedResumeTime}" Width="130"
                        ToolTip.Tip="The longest the scan stays on a busy channel before it carries on. It still leaves sooner if the signal drops. A channel left this way is passed by for ten seconds so the others get a turn. Hold stays until the signal drops." />
            </StackPanel>
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- Not a page either: choosing it opens the Help window -->
      <TabItem x:Name="HelpTab" Header="Help"
               ToolTip.Tip="Open the Help: getting started, every tab explained, RadioReference, several radios and the hardware" />
    </TabControl>
    </Panel>
  </DockPanel>
  </Panel>
</Window>
