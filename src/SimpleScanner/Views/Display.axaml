<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimpleScanner.ViewModels"
             xmlns:c="using:SimpleScanner.Controls"
             x:Class="SimpleScanner.Views.Display"
             x:DataType="vm:MainViewModel">
  <!-- What a scanner shows on its display. The full window shows it at its own size; the small window scales it. -->
  <StackPanel Spacing="6">
    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <TextBlock Text="OVERLOAD" Foreground="{DynamicResource LcdWarn}" FontSize="13" FontWeight="SemiBold"
                   IsVisible="{Binding Overloaded}" VerticalAlignment="Center" />
        <TextBlock Text="ENCRYPTED" Foreground="{DynamicResource LcdWarn}" FontSize="13" FontWeight="SemiBold"
                   IsVisible="{Binding IsEncrypted}" VerticalAlignment="Center" />
        <TextBlock Text="MUTE" Foreground="{DynamicResource LcdWarn}" FontSize="13" FontWeight="SemiBold"
                 IsVisible="{Binding IsMuted}" VerticalAlignment="Center" />
      <TextBlock Text="STEREO" Foreground="{DynamicResource LcdOpen}" FontSize="13" FontWeight="SemiBold"
                   IsVisible="{Binding IsStereo}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ModeText}" Foreground="{DynamicResource LcdText}" FontSize="20" FontWeight="SemiBold" />
        <Border CornerRadius="4" Padding="8,2" Background="{DynamicResource LcdOpen}" IsVisible="{Binding SquelchOpen}">
          <TextBlock Text="RX" Foreground="Black" FontSize="14" FontWeight="Bold" />
        </Border>
        <Border CornerRadius="4" Padding="8,2" BorderBrush="{DynamicResource LcdDim}" BorderThickness="1"
                IsVisible="{Binding !SquelchOpen}">
          <TextBlock Text="RX" Foreground="{DynamicResource LcdDim}" FontSize="14" FontWeight="Bold" />
        </Border>
      </StackPanel>
      <TextBlock Text="{Binding BandName}" Foreground="{DynamicResource LcdText}" FontSize="20"
                 TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
    </DockPanel>
    <!-- What is stored about the channel: whose it is, then its particulars -->
    <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource LcdText}" FontSize="14"
               TextTrimming="CharacterEllipsis" MinHeight="18" />
    <TextBlock Text="{Binding InfoText}" Foreground="{DynamicResource LcdDim}" FontSize="13"
               TextTrimming="CharacterEllipsis" MinHeight="17" />

    <!-- The power button at the left, the frequency in the middle, the small-window button at the right -->
    <Panel>
      <Button Classes="power" Classes.lit="{Binding IsOn}" Command="{Binding TogglePowerCommand}"
              HorizontalAlignment="Left" VerticalAlignment="Center"
              ToolTip.Tip="Start or stop the radio. Green when it is running.">
        <Path Width="24" Height="24" StrokeThickness="2.4" StrokeLineCap="Round"
              Data="M 12,3 L 12,11.5 M 7.5,5.6 A 8,8 0 1 0 16.5,5.6" />
      </Button>
      <Button Classes="power" Command="{Binding ToggleMiniCommand}" IsVisible="{Binding !IsMini}"
              HorizontalAlignment="Right" VerticalAlignment="Center"
              ToolTip.Tip="Small window: only the display, with Mute, Scan, Skip and Avoid under it">
        <Path Width="24" Height="24" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
              Data="M 20,4 L 14,10 M 14,5 L 14,10 L 19,10 M 4,20 L 10,14 M 5,14 L 10,14 L 10,19" />
      </Button>
      <Button Classes="power" Command="{Binding ToggleMiniCommand}" IsVisible="{Binding IsMini}"
              HorizontalAlignment="Right" VerticalAlignment="Center"
              ToolTip.Tip="Back to the full window">
        <Path Width="24" Height="24" StrokeThickness="2.2" StrokeLineCap="Round" StrokeJoin="Round"
              Data="M 14,10 L 20,4 M 15,4 L 20,4 L 20,9 M 10,14 L 4,20 M 4,15 L 4,20 L 9,20" />
      </Button>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
      <c:FrequencyReadout FrequencyHz="{Binding FrequencyHz}" FontSize="64"
                          Foreground="{DynamicResource LcdText}" DimForeground="{DynamicResource LcdDim}"
                          ToolTip.Tip="Roll the mouse wheel over a digit to tune by that digit; click its top or bottom half to step it" />
      <TextBlock Text="MHz" Foreground="{DynamicResource LcdDim}" FontSize="18" VerticalAlignment="Bottom" Margin="8,0,0,14" />
    </StackPanel>
    </Panel>

    <!-- What a digital signal says about itself -->
    <TextBlock Text="{Binding DigitalText}" Foreground="{DynamicResource LcdOpen}" FontSize="15" FontWeight="SemiBold"
               HorizontalAlignment="Center" MinHeight="20" />

    <DockPanel>
      <TextBlock DockPanel.Dock="Right" Text="{Binding LevelText}" Foreground="{DynamicResource LcdText}" FontSize="13"
                 Width="62" TextAlignment="Right" VerticalAlignment="Center" />
      <c:LevelBar Height="12" Value="{Binding Level}" Marker="{Binding SquelchDb}" ShowMarker="{Binding SquelchOn}"
                  Fill="{DynamicResource LcdText}" Track="{DynamicResource MeterTrack}" MarkerBrush="{DynamicResource LcdOpen}"
                  ToolTip.Tip="Signal level on the channel. The green mark is where the squelch opens." />
    </DockPanel>
    <DockPanel>
      <TextBlock DockPanel.Dock="Right" Text="{Binding DeviceText}" Foreground="{DynamicResource LcdDim}" FontSize="12" />
      <TextBlock Text="{Binding GainText}" Foreground="{DynamicResource LcdDim}" FontSize="12" />
    </DockPanel>
  </StackPanel>
</UserControl>
